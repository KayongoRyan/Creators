# FastAPI modular monolith (apps/api). Paths are joined onto this base.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Mock mode (default): localStorage portals + fixture reads.
# Set to 0 to call the real API (see docs/BACKEND_INTEGRATION.md).
NEXT_PUBLIC_USE_MOCK=1

# When live, the browser exchanges the demo session for a dev JWT
# (POST /api/auth/dev-token). Set to 0 once Supabase Auth issues the token.
NEXT_PUBLIC_AUTH_DEV=1

# Optional static bearer token. Skips the dev-token exchange.
# NEXT_PUBLIC_ACCESS_TOKEN=

# Optional: auto-seed demo role when using npm run dev:admin|brand|creator
# NEXT_PUBLIC_DEMO_ROLE=admin
