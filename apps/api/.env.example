# sqlite by default (apps/api/.data/ugc.db). Use the Supabase Postgres URI in production.
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# HS256 secret for dev JWTs. Supabase project JWT secret validates real access tokens.
JWT_SECRET=dev-only-change-me-please-32b
SUPABASE_JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# 1 enables lookup-only /auth/dev-token for local tests. Signup/login always use Supabase Auth.
AUTH_DEV=1

# CORS_ORIGINS=http://localhost:3000,http://localhost:3001
