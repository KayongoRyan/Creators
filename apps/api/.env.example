# sqlite by default (apps/api/.data/ugc.db). Use the Supabase Postgres URI in production.
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# HS256 secret for local JWTs. Rotate in production (never ship the placeholder).
JWT_SECRET=dev-only-change-me-please-32b
SUPABASE_JWT_SECRET=
# Leave empty for local bcrypt auth. Set all three for Supabase signup/login + Storage.
# ANON key is required for creator/brand email OTP (signup/start + verify).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Dev: 1 enables /auth/dev-token and local admin signup. Production: AUTH_DEV=0
AUTH_DEV=1
# Dev-only: skip Supabase OTP and accept code 000000 after /auth/signup/start. Never in production.
# AUTH_EMAIL_OTP_BYPASS=0

# See docs/AUTH_EMAIL_OTP.md for custom SMTP + Confirm signup template ({{ .Token }}).

# Optional: 1 re-seeds Primus/KCB demo rows when campaigns is empty (default off).
# SEED_DEMO=0

# Production: set explicit origins (no trailing slash). Dev defaults cover localhost ports.
# CORS_ORIGINS=https://app.example.com
# See docs/DEPLOY.md
