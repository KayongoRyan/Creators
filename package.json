{
  "name": "creators",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:admin": "node scripts/dev-role.mjs admin /admin",
    "dev:brand": "node scripts/dev-role.mjs brand /brand",
    "dev:creator": "node scripts/dev-role.mjs creator /creator",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev",
    "dev:reset": "node scripts/dev-reset.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:stack": "node scripts/dev-all.mjs --portals",
    "test:api": "python -m pytest -q -c apps/api/pyproject.toml apps/api/tests",
    "test:e2e": "playwright test",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "next": "^16.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
